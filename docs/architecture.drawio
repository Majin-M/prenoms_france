es continues 1900-2025&lt;/li&gt;&lt;li&gt;Effectifs multiples de 5&lt;/li&gt;&lt;li&gt;Codes géographiques&lt;/li&gt;&lt;li&gt;Régions ≤ France (avertissement)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=top;spacing=0;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="888" y="305" width="300" height="360" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;arrowWidth=0.45;arrowSize=0.3;" vertex="1" parent="1"><mxGeometry x="1204" y="395" width="52" height="40" as="geometry"/></mxCell><mxCell id="c31" value="Couche marts &lt;font style=&#x27;font-size:13px&#x27;&gt;(gold)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="360" height="32" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1260" y="165" width="360" height="505" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" vertex="1" parent="1"><mxGeometry x="1415.0" y="185" width="50" height="60" as="geometry"/></mxCell><mxCell id="c34" value="Données prêtes pour l&#x27;analyse" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=top;spacing=0;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1280" y="255" width="320" height="30" as="geometry"/></mxCell><mxCell id="c35" value="" style="line;strokeWidth=1;html=1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="292" width="280" height="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;div style=&#x27;margin-bottom:12px&#x27;&gt;&lt;b&gt;Modèles :&lt;/b&